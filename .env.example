# Copie para .env.local (fora do git) e preencha. Na Vercel, as mesmas variáveis vão em Settings > Environment Variables.

# IA (obrigatória para planejar cenas e para o @ia do chat)
OPENAI_API_KEY=
# Opcional: outro modelo de texto (padrão gpt-6-luna)
OPENAI_TEXT_MODEL=

# Colaboração: Upstash Redis (na Vercel, aba Storage > Upstash cria estas duas sozinha). Vazio no dev = memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: convites por e-mail via Resend
RESEND_API_KEY=
INVITE_FROM_EMAIL=

# Google OAuth (optional): authorize the exact callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://decupaai.vercel.app/api/google
# Local: http://localhost:5173/api/google (separate authorized URI)
GOOGLE_REDIRECT_URI=
